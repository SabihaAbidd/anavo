{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://anavo-api.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://anavo-api.onrender.com/health" }
  ]
}
